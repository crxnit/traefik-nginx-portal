# Install: sudo install -o root -g root -m 0644 logrotate/traefik-access /etc/logrotate.d/traefik-access
# Test:    sudo logrotate -d /etc/logrotate.d/traefik-access
#
# Traefik's access log (traefik.yml accessLog.filePath, bind-mounted from
# ./logs/traefik). 30 days at roughly 4 MB/day uncompressed. logrotate renames
# the file and then sends USR1; Traefik v3 reopens its log files on USR1, so
# no copytruncate (which can drop lines) and no restart.
# USR1 is sent with docker exec, not "docker kill -s": docker kill marks the
# container manually stopped, so restart: unless-stopped would not bring it
# back after a dockerd restart or reboot (outage 2026-11-02).
#
# logrotate does no shell expansion: the path below is literal. Change it if
# the portal is not installed at /srv/portal.
/srv/portal/logs/traefik/access.log {
    daily
    rotate 30
    dateext
    compress
    delaycompress
    missingok
    notifempty
    su root root
    postrotate
        /usr/bin/docker exec traefik kill -USR1 1 >/dev/null 2>&1 || true
    endscript
}
