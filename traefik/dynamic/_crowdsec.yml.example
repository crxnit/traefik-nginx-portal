# =============================================================================
# CrowdSec bouncer middlewares (AppSec/WAF + IP reputation) — OPT-IN.
# =============================================================================
# Ships as _crowdsec.yml.EXAMPLE so Traefik's file provider does NOT load it by
# default. Activating it before the bouncer plugin is declared in traefik.yml
# would log "middleware references unknown plugin" errors on the live proxy.
#
# To enable (full runbook in ../../CROWDSEC.md):
#   1. Uncomment the experimental.plugins.bouncer block in traefik/traefik.yml.
#   2. Bring up the crowdsec service (docker-compose.crowdsec.yml).
#   3. Generate a bouncer key into traefik/crowdsec/lapi-key (mode 600).
#   4. Rename this file:  _crowdsec.yml.example -> _crowdsec.yml
#   5. Attach `crowdsec-appsec@file` to a site's middleware chain.
#
# Why a key FILE and not ${ENV}: Traefik's file provider does not interpolate
# environment variables in dynamic YAML, and the LAPI key must never be
# committed. crowdsecLapiKeyFile points at a gitignored, container-mounted file.

http:
  middlewares:
    # Full protection: IP reputation (LAPI) + AppSec/WAF (SQLi, XSS, path
    # traversal, RCE, CVE virtual-patching). Attach to public-facing sites:
    #   middlewares: [security-headers@file, crowdsec-appsec@file, rate-limit@file]
    crowdsec-appsec:
      plugin:
        bouncer:
          enabled: true
          logLevel: INFO
          crowdsecMode: stream
          crowdsecLapiKeyFile: /etc/traefik/crowdsec/lapi-key
          crowdsecLapiHost: crowdsec:8080
          crowdsecLapiScheme: http
          crowdsecAppsecEnabled: true
          crowdsecAppsecHost: crowdsec:7422
          crowdsecAppsecFailureBlock: true
          crowdsecAppsecUnreachableBlock: true
          crowdsecAppsecBodyLimit: 10485760  # 10 MB
          updateIntervalSeconds: 60
          defaultDecisionSeconds: 60

    # Lighter weight: IP reputation only, no AppSec inspection. Use for
    # internal/low-risk services where WAF overhead isn't wanted.
    crowdsec-ip-only:
      plugin:
        bouncer:
          enabled: true
          logLevel: INFO
          crowdsecMode: stream
          crowdsecLapiKeyFile: /etc/traefik/crowdsec/lapi-key
          crowdsecLapiHost: crowdsec:8080
          crowdsecLapiScheme: http
          crowdsecAppsecEnabled: false
          updateIntervalSeconds: 60
          defaultDecisionSeconds: 60
