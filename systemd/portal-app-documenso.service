[Unit]
Description=Portal app — Documenso (e-sign)
Documentation=https://github.com/crxnit/traefik-nginx-portal
# Wants, not Requires, docker.service: Requires passes a docker restart on to
# this unit (ExecStop = compose down), so every unattended Docker upgrade took
# the stack down despite live-restore (2026-11-02, 2026-11-04). After= keeps
# the boot order.
Requires=portal-nginx.service
After=docker.service network-online.target portal-nginx.service
Wants=docker.service network-online.target

[Service]
# Documenso lives sibling to the portal repo, NOT inside it.
# Adjust APP_DIR and User if you installed under a different layout.
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/srv/portal-apps/documenso
User=portal
Group=portal
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
# First start may pull the documenso image + run Prisma migrations.
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
